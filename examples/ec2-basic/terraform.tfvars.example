# Copy this file to terraform.tfvars and fill in your values.
# Never commit terraform.tfvars to git — it contains your enrollment token.

customer_name     = "acme"
enrollment_token  = "<paste-from-argus-dashboard>"
argus_backend_url = "https://api.argusdspm.com"

aws_region    = "us-east-1"
instance_type = "t3.medium"
environment   = "prod"

# Datastore opt-ins
enable_s3_scanning = true

# SSH for debugging (production: leave disabled)
enable_ssh_access   = false
allowed_cidr_blocks = []
# key_pair_name      = "your-key"
